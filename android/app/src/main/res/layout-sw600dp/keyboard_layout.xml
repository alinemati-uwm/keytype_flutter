<?xml version="1.0" encoding="utf-8"?>
<!-- Large screen layout for keyboard (tablets) - optimized for larger displays -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="?attr/keyboardBackgroundColor"
    android:padding="16dp">

    <!-- Enhanced AI Action Buttons Row - Larger for tablets -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <!-- Enhanced Rewrite Button -->
        <LinearLayout
            android:id="@+id/rewrite_button"
            android:layout_width="0dp"
            android:layout_height="@dimen/ai_button_height_large"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:background="@drawable/ai_button_rewrite_bg"
            android:padding="16dp"
            android:layout_marginEnd="12dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:contentDescription="@string/accessibility_rewrite_button"
            android:importantForAccessibility="yes"
            android:minHeight="@dimen/recommended_touch_target_size"
            android:minWidth="@dimen/recommended_touch_target_size">

            <ImageView
                android:id="@+id/rewrite_icon"
                android:layout_width="@dimen/icon_size_large"
                android:layout_height="@dimen/icon_size_large"
                android:src="@drawable/ic_edit_modern"
                android:layout_marginEnd="12dp"
                android:contentDescription="@string/accessibility_rewrite_button"
                android:tint="?attr/aiButtonTextColor"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/rewrite_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rewrite"
                android:textSize="@dimen/ai_button_text_size_large"
                android:textColor="?attr/aiButtonTextColor"
                android:fontFamily="sans-serif-medium"
                android:importantForAccessibility="no" />

            <ProgressBar
                android:id="@+id/rewrite_progress"
                android:layout_width="@dimen/icon_size_large"
                android:layout_height="@dimen/icon_size_large"
                android:layout_marginStart="12dp"
                android:visibility="gone"
                android:indeterminateTint="?attr/aiButtonTextColor"
                style="?android:attr/progressBarStyleSmall" />

        </LinearLayout>

        <!-- Summarize Button -->
        <LinearLayout
            android:id="@+id/summarize_button"
            android:layout_width="0dp"
            android:layout_height="@dimen/ai_button_height_large"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:background="@drawable/ai_button_summarize_bg"
            android:padding="16dp"
            android:layout_marginEnd="12dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:contentDescription="@string/accessibility_summarize_button"
            android:importantForAccessibility="yes"
            android:minHeight="@dimen/recommended_touch_target_size"
            android:minWidth="@dimen/recommended_touch_target_size">

            <ImageView
                android:id="@+id/summarize_icon"
                android:layout_width="@dimen/icon_size_large"
                android:layout_height="@dimen/icon_size_large"
                android:src="@drawable/ic_summarize"
                android:layout_marginEnd="12dp"
                android:contentDescription="@string/accessibility_summarize_button"
                android:tint="?attr/aiButtonTextColor"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/summarize_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Summarize"
                android:textSize="@dimen/ai_button_text_size_large"
                android:textColor="?attr/aiButtonTextColor"
                android:fontFamily="sans-serif-medium"
                android:importantForAccessibility="no" />

            <ProgressBar
                android:id="@+id/summarize_progress"
                android:layout_width="@dimen/icon_size_large"
                android:layout_height="@dimen/icon_size_large"
                android:layout_marginStart="12dp"
                android:visibility="gone"
                android:indeterminateTint="?attr/aiButtonTextColor"
                style="?android:attr/progressBarStyleSmall" />

        </LinearLayout>

        <!-- Generate Button -->
        <LinearLayout
            android:id="@+id/generate_button"
            android:layout_width="0dp"
            android:layout_height="@dimen/ai_button_height_large"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:background="@drawable/ai_button_generate_bg"
            android:padding="16dp"
            android:layout_marginEnd="16dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:contentDescription="@string/accessibility_generate_button"
            android:importantForAccessibility="yes"
            android:minHeight="@dimen/recommended_touch_target_size"
            android:minWidth="@dimen/recommended_touch_target_size">

            <ImageView
                android:id="@+id/generate_icon"
                android:layout_width="@dimen/icon_size_large"
                android:layout_height="@dimen/icon_size_large"
                android:src="@drawable/ic_generate"
                android:layout_marginEnd="12dp"
                android:contentDescription="@string/accessibility_generate_button"
                android:tint="?attr/aiButtonTextColor"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/generate_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Generate"
                android:textSize="@dimen/ai_button_text_size_large"
                android:textColor="?attr/aiButtonTextColor"
                android:fontFamily="sans-serif-medium"
                android:importantForAccessibility="no" />

            <ProgressBar
                android:id="@+id/generate_progress"
                android:layout_width="@dimen/icon_size_large"
                android:layout_height="@dimen/icon_size_large"
                android:layout_marginStart="12dp"
                android:visibility="gone"
                android:indeterminateTint="?attr/aiButtonTextColor"
                style="?android:attr/progressBarStyleSmall" />

        </LinearLayout>

        <!-- Theme Toggle Button -->
        <ImageButton
            android:id="@+id/theme_toggle"
            android:layout_width="@dimen/ai_button_height_large"
            android:layout_height="@dimen/ai_button_height_large"
            android:background="@drawable/theme_toggle_bg"
            android:src="@drawable/ic_theme_selector"
            android:contentDescription="@string/accessibility_theme_toggle"
            android:clickable="true"
            android:focusable="true"
            android:scaleType="centerInside"
            android:tint="?attr/themeToggleIconColor"
            android:importantForAccessibility="yes"
            android:minHeight="@dimen/recommended_touch_target_size"
            android:minWidth="@dimen/recommended_touch_target_size" />

    </LinearLayout>

    <!-- Main Keyboard View -->
    <android.inputmethodservice.KeyboardView
        android:id="@+id/keyboard_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:keyBackground="@drawable/key_background_modern"
        android:keyTextColor="?attr/keyTextColor"
        android:keyPreviewLayout="@layout/key_preview"
        android:shadowColor="?attr/keyShadowColor"
        android:shadowRadius="2"
        android:layout_marginTop="8dp"
        android:importantForAccessibility="yes"
        android:contentDescription="@string/accessibility_keyboard_letters" />

</LinearLayout>