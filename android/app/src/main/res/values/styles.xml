<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Theme applied to the Android Window while the process is starting when the OS's Dark Mode setting is off -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <!-- Show a splash screen on the activity. Automatically removed when
             the Flutter engine draws its first frame -->
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Theme applied to the Android Window as soon as the process has started.
         This theme determines the color of the Android Window while your
         Flutter UI initializes, as well as behind your Flutter UI while its
         running.

         This Theme is only used starting with V2 of Flutter's Android embedding. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
    
    <!-- Keyboard Light Theme -->
    <style name="KeyboardLightTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <!-- Background Colors -->
        <item name="keyboardBackgroundColor">@color/keyboard_bg_light</item>
        <item name="keyBackgroundColor">@color/key_bg_light</item>
        <item name="actionKeyBackgroundColor">@color/action_key_bg_light</item>
        <item name="keyPressedColor">@color/key_pressed_light</item>
        
        <!-- Text Colors -->
        <item name="keyTextColor">@color/key_text_light</item>
        <item name="keyTextSecondaryColor">@color/key_text_secondary_light</item>
        <item name="actionKeyTextColor">@color/action_key_text_light</item>
        
        <!-- Border and Shadow -->
        <item name="keyBorderColor">@color/border_light</item>
        <item name="keyShadowColor">@color/shadow_light</item>
        
        <!-- AI Button Colors -->
        <item name="aiButtonRewriteStartColor">@color/ai_button_rewrite_start_light</item>
        <item name="aiButtonRewriteEndColor">@color/ai_button_rewrite_end_light</item>
        <item name="aiButtonSummarizeStartColor">@color/ai_button_summarize_start_light</item>
        <item name="aiButtonSummarizeEndColor">@color/ai_button_summarize_end_light</item>
        <item name="aiButtonGenerateStartColor">@color/ai_button_generate_start_light</item>
        <item name="aiButtonGenerateEndColor">@color/ai_button_generate_end_light</item>
        <item name="aiButtonTextColor">@color/ai_button_text_light</item>
        
        <!-- Theme Toggle Colors -->
        <item name="themeToggleBackgroundColor">@color/theme_toggle_bg_light</item>
        <item name="themeToggleIconColor">@color/theme_toggle_icon_light</item>
        
        <!-- Status Colors -->
        <item name="successColor">@color/success_light</item>
        <item name="errorColor">@color/error_light</item>
        <item name="warningColor">@color/warning_light</item>
        
        <!-- Icon Colors -->
        <item name="actionKeyIconColor">@color/action_key_text_light</item>
        <item name="aiButtonIconColor">@color/ai_button_text_light</item>
        <item name="keyboardModeIconColor">@color/key_text_secondary_light</item>
        
        <!-- Accessibility Attributes -->
        <item name="minTouchTargetSize">@dimen/min_touch_target_size</item>
        <item name="iconSize">@dimen/icon_size_medium</item>
        <item name="aiButtonTextSize">@dimen/ai_button_text_size_medium</item>
        <item name="keyboardScale">1.0</item>
        <item name="longPressDelay">500</item>
        
        <!-- High Contrast Colors -->
        <item name="highContrastKeyBackground">@color/high_contrast_light_key_background</item>
        <item name="highContrastKeyText">@color/high_contrast_light_key_text</item>
        <item name="highContrastKeyBorder">@color/high_contrast_light_key_border</item>
        <item name="highContrastActionKeyBackground">@color/high_contrast_light_action_key</item>
        <item name="highContrastAIButtonBackground">@color/high_contrast_light_ai_button</item>
        
        <!-- Color Blind Friendly Colors -->
        <item name="colorBlindSafeColor1">@color/colorblind_safe_blue</item>
        <item name="colorBlindSafeColor2">@color/colorblind_safe_orange</item>
        <item name="colorBlindSafeColor3">@color/colorblind_safe_green</item>
    </style>
    
    <!-- Keyboard Dark Theme -->
    <style name="KeyboardDarkTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <!-- Background Colors -->
        <item name="keyboardBackgroundColor">@color/keyboard_bg_dark</item>
        <item name="keyBackgroundColor">@color/key_bg_dark</item>
        <item name="actionKeyBackgroundColor">@color/action_key_bg_dark</item>
        <item name="keyPressedColor">@color/key_pressed_dark</item>
        
        <!-- Text Colors -->
        <item name="keyTextColor">@color/key_text_dark</item>
        <item name="keyTextSecondaryColor">@color/key_text_secondary_dark</item>
        <item name="actionKeyTextColor">@color/action_key_text_dark</item>
        
        <!-- Border and Shadow -->
        <item name="keyBorderColor">@color/border_dark</item>
        <item name="keyShadowColor">@color/shadow_dark</item>
        
        <!-- AI Button Colors -->
        <item name="aiButtonRewriteStartColor">@color/ai_button_rewrite_start_dark</item>
        <item name="aiButtonRewriteEndColor">@color/ai_button_rewrite_end_dark</item>
        <item name="aiButtonSummarizeStartColor">@color/ai_button_summarize_start_dark</item>
        <item name="aiButtonSummarizeEndColor">@color/ai_button_summarize_end_dark</item>
        <item name="aiButtonGenerateStartColor">@color/ai_button_generate_start_dark</item>
        <item name="aiButtonGenerateEndColor">@color/ai_button_generate_end_dark</item>
        <item name="aiButtonTextColor">@color/ai_button_text_dark</item>
        
        <!-- Theme Toggle Colors -->
        <item name="themeToggleBackgroundColor">@color/theme_toggle_bg_dark</item>
        <item name="themeToggleIconColor">@color/theme_toggle_icon_dark</item>
        
        <!-- Status Colors -->
        <item name="successColor">@color/success_dark</item>
        <item name="errorColor">@color/error_dark</item>
        <item name="warningColor">@color/warning_dark</item>
        
        <!-- Icon Colors -->
        <item name="actionKeyIconColor">@color/action_key_text_dark</item>
        <item name="aiButtonIconColor">@color/ai_button_text_dark</item>
        <item name="keyboardModeIconColor">@color/key_text_secondary_dark</item>
        
        <!-- Accessibility Attributes -->
        <item name="minTouchTargetSize">@dimen/min_touch_target_size</item>
        <item name="iconSize">@dimen/icon_size_medium</item>
        <item name="aiButtonTextSize">@dimen/ai_button_text_size_medium</item>
        <item name="keyboardScale">1.0</item>
        <item name="longPressDelay">500</item>
        
        <!-- High Contrast Colors -->
        <item name="highContrastKeyBackground">@color/high_contrast_dark_key_background</item>
        <item name="highContrastKeyText">@color/high_contrast_dark_key_text</item>
        <item name="highContrastKeyBorder">@color/high_contrast_dark_key_border</item>
        <item name="highContrastActionKeyBackground">@color/high_contrast_dark_action_key</item>
        <item name="highContrastAIButtonBackground">@color/high_contrast_dark_ai_button</item>
        
        <!-- Color Blind Friendly Colors -->
        <item name="colorBlindSafeColor1">@color/colorblind_safe_blue</item>
        <item name="colorBlindSafeColor2">@color/colorblind_safe_orange</item>
        <item name="colorBlindSafeColor3">@color/colorblind_safe_green</item>
    </style>
</resources>
