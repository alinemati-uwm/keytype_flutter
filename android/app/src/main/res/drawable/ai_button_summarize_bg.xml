<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pressed state -->
    <item android:state_pressed="true">
        <layer-list>
            <!-- Shadow layer -->
            <item android:top="2dp" android:left="2dp">
                <shape android:shape="rectangle">
                    <solid android:color="?attr/keyShadowColor"/>
                    <corners android:radius="16dp"/>
                </shape>
            </item>
            <!-- Main gradient background with pressed effect -->
            <item android:bottom="2dp" android:right="2dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:type="linear"
                        android:angle="135"
                        android:startColor="?attr/aiButtonSummarizeStartColor"
                        android:endColor="?attr/aiButtonSummarizeEndColor"/>
                    <corners android:radius="14dp"/>
                    <stroke 
                        android:width="1dp" 
                        android:color="?attr/aiButtonSummarizeEndColor"/>
                </shape>
            </item>
            <!-- Pressed overlay -->
            <item android:bottom="2dp" android:right="2dp">
                <shape android:shape="rectangle">
                    <solid android:color="#20000000"/>
                    <corners android:radius="14dp"/>
                </shape>
            </item>
        </layer-list>
    </item>
    
    <!-- Normal state -->
    <item>
        <layer-list>
            <!-- Shadow layer -->
            <item android:top="2dp" android:left="2dp">
                <shape android:shape="rectangle">
                    <solid android:color="?attr/keyShadowColor"/>
                    <corners android:radius="16dp"/>
                </shape>
            </item>
            <!-- Main gradient background -->
            <item android:bottom="2dp" android:right="2dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:type="linear"
                        android:angle="135"
                        android:startColor="?attr/aiButtonSummarizeStartColor"
                        android:endColor="?attr/aiButtonSummarizeEndColor"/>
                    <corners android:radius="14dp"/>
                </shape>
            </item>
            <!-- Subtle highlight overlay -->
            <item android:bottom="2dp" android:right="2dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:type="linear"
                        android:angle="90"
                        android:startColor="#20FFFFFF"
                        android:centerColor="#10FFFFFF"
                        android:endColor="#00FFFFFF"/>
                    <corners android:radius="14dp"/>
                </shape>
            </item>
        </layer-list>
    </item>
</selector>