<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pressed state with animation-ready properties -->
    <item android:state_pressed="true">
        <layer-list>
            <!-- Shadow layer for depth -->
            <item android:top="1dp" android:left="1dp">
                <shape android:shape="rectangle">
                    <solid android:color="?attr/keyShadowColor"/>
                    <corners android:radius="12dp"/>
                </shape>
            </item>
            <!-- Main background -->
            <item android:bottom="1dp" android:right="1dp">
                <shape android:shape="rectangle">
                    <solid android:color="?attr/keyPressedColor"/>
                    <corners android:radius="10dp"/>
                    <stroke 
                        android:width="1dp" 
                        android:color="?attr/keyBorderColor"/>
                </shape>
            </item>
            <!-- Pressed overlay for visual feedback -->
            <item android:bottom="1dp" android:right="1dp">
                <shape android:shape="rectangle">
                    <solid android:color="#15000000"/>
                    <corners android:radius="10dp"/>
                </shape>
            </item>
        </layer-list>
    </item>
    
    <!-- Focused state (for accessibility) -->
    <item android:state_focused="true">
        <layer-list>
            <!-- Shadow layer -->
            <item android:top="2dp" android:left="2dp">
                <shape android:shape="rectangle">
                    <solid android:color="?attr/keyShadowColor"/>
                    <corners android:radius="12dp"/>
                </shape>
            </item>
            <!-- Main background -->
            <item android:bottom="2dp" android:right="2dp">
                <shape android:shape="rectangle">
                    <solid android:color="?attr/keyBackgroundColor"/>
                    <corners android:radius="10dp"/>
                    <stroke 
                        android:width="2dp" 
                        android:color="?attr/aiButtonRewriteStartColor"/>
                </shape>
            </item>
        </layer-list>
    </item>
    
    <!-- Normal state -->
    <item>
        <layer-list>
            <!-- Shadow layer -->
            <item android:top="2dp" android:left="2dp">
                <shape android:shape="rectangle">
                    <solid android:color="?attr/keyShadowColor"/>
                    <corners android:radius="12dp"/>
                </shape>
            </item>
            <!-- Main background -->
            <item android:bottom="2dp" android:right="2dp">
                <shape android:shape="rectangle">
                    <solid android:color="?attr/keyBackgroundColor"/>
                    <corners android:radius="10dp"/>
                    <stroke 
                        android:width="1dp" 
                        android:color="?attr/keyBorderColor"/>
                </shape>
            </item>
            <!-- Subtle highlight for depth -->
            <item android:bottom="2dp" android:right="2dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:type="linear"
                        android:angle="90"
                        android:startColor="#10FFFFFF"
                        android:centerColor="#05FFFFFF"
                        android:endColor="#00FFFFFF"/>
                    <corners android:radius="10dp"/>
                </shape>
            </item>
        </layer-list>
    </item>
</selector>