<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pressed state -->
    <item android:state_pressed="true">
        <layer-list>
            <!-- Shadow layer -->
            <item android:top="2dp" android:left="2dp">
                <shape android:shape="oval">
                    <solid android:color="?attr/keyShadowColor"/>
                </shape>
            </item>
            <!-- Main circular background with pressed effect -->
            <item android:bottom="2dp" android:right="2dp">
                <shape android:shape="oval">
                    <solid android:color="?attr/themeToggleBackgroundColor"/>
                    <stroke 
                        android:width="1dp" 
                        android:color="?attr/keyBorderColor"/>
                </shape>
            </item>
            <!-- Pressed overlay -->
            <item android:bottom="2dp" android:right="2dp">
                <shape android:shape="oval">
                    <solid android:color="#20000000"/>
                </shape>
            </item>
        </layer-list>
    </item>
    
    <!-- Normal state -->
    <item>
        <layer-list>
            <!-- Shadow layer -->
            <item android:top="2dp" android:left="2dp">
                <shape android:shape="oval">
                    <solid android:color="?attr/keyShadowColor"/>
                </shape>
            </item>
            <!-- Main circular background -->
            <item android:bottom="2dp" android:right="2dp">
                <shape android:shape="oval">
                    <solid android:color="?attr/themeToggleBackgroundColor"/>
                    <stroke 
                        android:width="1dp" 
                        android:color="?attr/keyBorderColor"/>
                </shape>
            </item>
            <!-- Subtle highlight overlay -->
            <item android:bottom="2dp" android:right="2dp">
                <shape android:shape="oval">
                    <gradient
                        android:type="radial"
                        android:gradientRadius="50%"
                        android:centerX="0.3"
                        android:centerY="0.3"
                        android:startColor="#30FFFFFF"
                        android:endColor="#00FFFFFF"/>
                </shape>
            </item>
        </layer-list>
    </item>
</selector>